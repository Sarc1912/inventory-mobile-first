  "narrative": {
    "northStar": "Mercado cálido",
    "overview": "La dirección confirmada combina crema, terracota y verde bosque. Manrope mantiene una voz cotidiana y legible; las cantidades, los estados y las acciones tienen más protagonismo que la decoración. La implementación es code-first.\n\nEste documento describe el código enviado. PRODUCT.md conserva la verdad de producto y el brief de superficie conserva la composición específica del inventario.",
    "keyCharacteristics": [
      "Fondo cálido, tinta bosque y acciones terracota.",
      "Listas abiertas y cantidades tabulares alineadas.",
      "Contenedores suavemente redondeados y poca elevación.",
      "Estados con texto, iconos y color."
    ],
    "rules": [
      {
        "name": "La regla del estado explícito",
        "body": "Un pendiente o conflicto conserva su texto además del color; el verde de confirmación acompaña un icono de verificación.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do usar la paleta cálida confirmada y conservar la jerarquía de las cantidades.",
      "Do mantener etiquetas e iconos junto al color de estado.",
      "Do conservar el foco visible y espacio para la navegación inferior.",
      "Do representar explícitamente la ausencia de foto."
    ],
    "donts": [
      "Don't convertir cada fila en una tarjeta elevada por defecto.",
      "Don't presentar pendientes con tratamiento de confirmación.",
      "Don't convertir estos documentos visuales en promesas de integración."
